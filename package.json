{
  "name": "svelte-number-format",
  "description": "Lightweight, reactive number and pattern formatting for Svelte 5. NumericFormat & PatternFormat for inputs, NumericText & PatternText for SSR-safe display.",
  "version": "2.1.0",
  "author": {
    "name": "Pitiș Radu",
    "url": "https://github.com/pitis"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitis/svelte-number-format.git"
  },
  "homepage": "https://pitis.github.io/svelte-number-format/",
  "bugs": {
    "url": "https://github.com/pitis/svelte-number-format/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "deploy": "pnpm build && gh-pages -d build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "pnpm test:unit --run",
    "size": "pnpm package && size-limit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ],
    "src/**/*.{spec,test}.{js,ts}": [
      "vitest related --run"
    ]
  },
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-component",
    "number-format",
    "currency",
    "percentage",
    "input-mask",
    "masked-input",
    "phone-number",
    "credit-card",
    "date-input",
    "pattern-format",
    "numeric-input",
    "numeric-text",
    "pattern-text",
    "formatted-input",
    "intl",
    "internationalization",
    "i18n",
    "ssr"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./numeric": {
      "types": "./dist/numeric.d.ts",
      "svelte": "./dist/numeric.js",
      "import": "./dist/numeric.js",
      "default": "./dist/numeric.js"
    },
    "./pattern": {
      "types": "./dist/pattern.d.ts",
      "svelte": "./dist/pattern.js",
      "import": "./dist/pattern.js",
      "default": "./dist/pattern.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "svelte": "./dist/patterns.js",
      "import": "./dist/patterns.js",
      "default": "./dist/patterns.js"
    },
    "./display": {
      "types": "./dist/display.d.ts",
      "svelte": "./dist/display.js",
      "import": "./dist/display.js",
      "default": "./dist/display.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pitis"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@felte/validator-zod": "^1.0.18",
    "@size-limit/file": "^13.0.3",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "felte": "^1.3.0",
    "formsnap": "^2.0.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^2.30.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "intl-number-input": "^1.4.1"
  }
}
